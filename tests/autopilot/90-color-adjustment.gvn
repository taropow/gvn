expect	adjust.gray	2
adjust_range	Hue	-180	180	0
adjust_range	Saturation	-100	100	0
adjust_set	Hue	empty
expect	adjust.valid	false
expect	adjust.ok_enabled	false
adjust_set	Hue	0
adjust_scroll	Hue	75
adjust_scroll	Saturation	-40
adjust_scroll	Lightness	15
adjust_range	Hue	-180	180	75
adjust_range	Saturation	-100	100	-40
adjust_range	Lightness	-100	100	15
adjust_snapshot	adjust-alpha.png
adjust_cancel
