# Actual native window fields, frozen official input cases and tiny RGBA-preserving startup.
resize	800	600
open	${fixtures}/alpha.png
wait
settings
tab	Window
expect	text_limit.WindowX	30000
expect	text_limit.WindowY	30000
expect	text_limit.WindowWidth	30000
expect	text_limit.WindowHeight	30000
expect	number_only.WindowX	false
expect	number_only.WindowY	false
expect	number_only.WindowWidth	true
expect	number_only.WindowHeight	true
set	StartupPosition	2
set	StartupState	0
# Official input: small
set	WindowX	0
set	WindowY	0
set	WindowWidth	480
set	WindowHeight	360
click	ApplyButton
set	WindowX	37
set	WindowY	49
set	WindowWidth	100
set	WindowHeight	80
click	ApplyButton
expect	settings.window_x	37
expect	settings.window_y	49
expect	settings.window_width	100
expect	settings.window_height	80
expect_text	WindowX	37
expect_text	WindowY	49
expect_text	WindowWidth	100
expect_text	WindowHeight	80
persisted
