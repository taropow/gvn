# Native controls and actual decoded pixels; only scenario-owned files/attributes.
resize	900	700
open	${fixtures}/loading/rgba-background.png
wait
remember	raw
pixel_copy
expect_pixel	2	0	0	0	255	0
settings
tab	Background
set	Checker	false
tab	Loading
set	TransparencyBackground	123456
click	TransparencyBackgroundPick
color_expect	18	52	86
color_set	160	176	192
color_snapshot	loading-color-dialog.png
color_close	OK
click	TransparencyBackgroundPick
color_set	1	2	3
color_close	Cancel
expect_text	TransparencyBackground	A0B0C0
set	PreserveAlpha	false
snapshot	loading-options.png
click	OK
wait
expect_pixel	2	0	160	176	192	255
pixel_copy
settings
tab	Loading
set	PngBackground	true
click	OK
wait
expect_pixel	2	0	18	52	86	255
settings
tab	Loading
set	PngTransparency	false
click	OK
wait
expect_pixel	2	0	0	0	255	255
settings
tab	Loading
set	PreserveAlpha	true
set	PngTransparency	true
click	OK
wait
expect_same	raw	true
pixel_copy
open	${fixtures}/loading/alpha-v4.bmp
wait
expect_pixel	2	0	0	0	255	0
settings
tab	Loading
set	PreserveAlpha	false
click	OK
wait
